{
  "name": "iquesters/event",
  "description": "Events for organisations: publish events, members register (free or paid, with guests and meals), admins see attendees. Built on the iquesters modules.",
  "keywords": [
    "laravel",
    "events",
    "registration",
    "attendees",
    "iquesters"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/iquesters/event",
  "support": {
    "issues": "https://github.com/iquesters/event/issues",
    "source": "https://github.com/iquesters/event",
    "docs": "https://github.com/iquesters/event/tree/main/docs"
  },
  "authors": [
    {
      "name": "Pritam Bag",
      "email": "pritam02b@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0",
    "iquesters/foundation": "^2.1",
    "iquesters/user-interface": "^2.2",
    "iquesters/organisation": "^2.2",
    "iquesters/commerce": "^2.0",
    "spatie/laravel-permission": "^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "laravel/sanctum": "^4.0",
    "laravel/pint": "^1.18",
    "larastan/larastan": "^3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../foundation",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/foundation": "2.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../user-interface",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/user-interface": "2.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../organisation",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/organisation": "2.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../commerce",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/commerce": "2.99.0"
        }
      }
    }
  ],
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "autoload": {
    "psr-4": {
      "Iquesters\\Event\\": "src/",
      "Iquesters\\Event\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Iquesters\\Event\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Iquesters\\Event\\EventServiceProvider"
      ]
    }
  },
  "suggest": {
    "iquesters/payment": "The pay page (UPI QR, proof, verification) for paid registrations",
    "iquesters/notifications": "Emails people when things happen (registration, payment, membership), with wording each organisation can edit"
  }
}
